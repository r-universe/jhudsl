[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "mscstts"]
	path = mscstts
	url = https://github.com/jhudsl/mscstts
[submodule "ottrpal"]
	path = ottrpal
	url = https://github.com/jhudsl/ottrpal
[submodule "text2speech"]
	path = text2speech
	url = https://github.com/jhudsl/text2speech
